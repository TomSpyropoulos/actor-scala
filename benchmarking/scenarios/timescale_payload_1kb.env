# Payload sweep — 1KB padding per message, 50 rows / 200ms, pool 20, 20 publishers
DB_BACKEND=timescaledb
DB_URL=jdbc:postgresql://timescaledb:5432/epu
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_SIZE=20
BATCH_ENABLED=true
BATCH_SIZE=50
BATCH_TIMEOUT_MS=200
PUBLISHER_COUNT=20
PAYLOAD_PADDING_BYTES=1024
